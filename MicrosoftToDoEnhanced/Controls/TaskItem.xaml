<UserControl x:Class="MicrosoftToDoEnhanced.Controls.TaskItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="72" d:DesignWidth="480">

    <Border x:Name="Root"
            Padding="12,10"
            Margin="0,0,0,8"
            MouseLeftButtonUp="OnItemClicked"
            AllowDrop="True">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}"/>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-1" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.RenderTransform>
            <TranslateTransform Y="0"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="DragGrip" Grid.Column="0" Width="16" VerticalAlignment="Center" Margin="-4,0,4,0"
                  Cursor="SizeAll" ToolTip="Drag to reorder"
                  Visibility="{Binding CanReorder, Converter={StaticResource BoolToVisibilityConverter}}">
                <Path Width="8" Height="14" Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}"
                      Data="M0,0 h2 v2 h-2 Z M4,0 h2 v2 h-2 Z M0,4 h2 v2 h-2 Z M4,4 h2 v2 h-2 Z M0,8 h2 v2 h-2 Z M4,8 h2 v2 h-2 Z"/>
            </Grid>

            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                      IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                      Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}"
                      ClickMode="Press" Cursor="Hand">
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                     Fill="Transparent"/>
                            <Ellipse x:Name="FillCircle" Margin="1.5" Fill="{DynamicResource AccentBrush}" Opacity="0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="FillScale" ScaleX="0.5" ScaleY="0.5" CenterX="8.5" CenterY="8.5"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Path x:Name="Check" Width="9" Height="7" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"
                                  Data="M0,4 L3,7 L9,0 L7.9,-1 L3,5 L1.1,3.2 Z" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FillCircle" Property="Opacity" Value="1"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>

            <Border Grid.Column="2" CornerRadius="1.5" VerticalAlignment="Stretch"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>

            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="{Binding TaskName}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding DueDate, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <Path Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource TextTertiaryBrush}"
                              Data="M0,1.2 L10,1.2 L10,9 L0,9 Z M1.2,0 L2.2,0 L2.2,1.8 L1.2,1.8 Z M7.8,0 L8.8,0 L8.8,1.8 L7.8,1.8 Z M1.5,3.5 L8.5,3.5 L8.5,7.8 L1.5,7.8 Z"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="4,0,10,0"
                                   Text="{Binding DueDate, StringFormat='ddd, MMM d'}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding RecurrenceName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <Path Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource TextTertiaryBrush}"
                              Data="M5,0 A5,5 0 1 1 0,5 L1.2,5 A3.8,3.8 0 1 0 5,1.2 Z M4,2 L4,5.2 L6.5,6.6 L6.9,5.8 L5,4.7 L5,2 Z"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="4,0,10,0"
                                   Text="{Binding RecurrenceName}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,10,0"
                               Visibility="{Binding StepsSummary, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                               Text="{Binding StepsSummary}"/>

                    <Path Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                          Fill="{DynamicResource TextTertiaryBrush}"
                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibilityConverter}}"
                          Data="M8,0 L2,0 L2,10 L10,10 L10,2 Z M7.5,1 L9,2.5 L7.5,2.5 Z M3,7.5 L6,4.5 L7,5.5 L8.5,4 L10,5.5 L10,9 L2,9 L2,8 Z"/>

                    <Border Margin="0,0,4,0"
                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusName}" Value="Pending">
                                        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusName}" Value="Pending">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusPendingBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusName}" Value="Incomplete">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Margin="0,0,10,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                            <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LevelName}" Value="High">
                                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="7" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                              Data="M0,9 L0,2.5 L3.5,0 L7,2.5 L7,9 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelName}" Value="High">
                                            <Setter Property="Fill" Value="{DynamicResource PriorityHighBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelName}" Value="Medium">
                                            <Setter Property="Fill" Value="{DynamicResource PriorityMediumBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelName}" Value="Low">
                                            <Setter Property="Fill" Value="{DynamicResource PriorityLowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding LevelName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LevelName}" Value="High">
                                            <Setter Property="Foreground" Value="{DynamicResource PriorityHighBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelName}" Value="Medium">
                                            <Setter Property="Foreground" Value="{DynamicResource PriorityMediumBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LevelName}" Value="Low">
                                            <Setter Property="Foreground" Value="{DynamicResource PriorityLowBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Width="26" Height="26" ToolTip="{Binding AssignedToName, StringFormat=Assigned to {0}}"
                      Visibility="{Binding AssignedToName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <Ellipse Fill="{Binding AssignedToColor, Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                               FontWeight="SemiBold" Foreground="White"
                               Text="{Binding AssignedToName, Converter={StaticResource InitialsConverter}}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
