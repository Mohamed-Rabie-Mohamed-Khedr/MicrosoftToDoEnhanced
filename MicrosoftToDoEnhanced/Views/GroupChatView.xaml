<Window x:Class="MicrosoftToDoEnhanced.Views.GroupChatView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group chat"
        Icon="pack://application:,,,/app.ico"
        Height="640" Width="1320" MinHeight="480" MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                      Data="M3,0 h10 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-10 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 Z M4,5 h8 v2 h-8 Z M4,8 h8 v2 h-8 Z M4,11 h5 v2 h-5 Z"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding GroupName}" Style="{StaticResource PageTitleTextStyle}" FontSize="18"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding GroupDescription}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="Edit group"
                    Command="{Binding OpenEditGroupCommand}"
                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M5.5,0 L6.9,1.1 L8.6,0.9 L9.1,2.6 L10.6,3.5 L10.1,5.1 L11,6.5 L10,8 L8.4,8.6 L7.8,10.2 L6,10.4 L5.5,12 L5,10.4 L3.2,10.2 L2.6,8.6 L1,8 L0,6.5 L0.9,5.1 L0.4,3.5 L1.9,2.6 L2.4,0.9 L4.1,1.1 Z"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Style="{StaticResource SecondaryButtonStyle}" MinHeight="30" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Visibility="{Binding HasMorePosts, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding LoadMorePostsCommand}">
                        <TextBlock>
                            <Run Text="L" TextDecorations="Underline"/><Run Text="oad older"/>
                        </TextBlock>
                    </Button>

                    <ListBox Grid.Row="1" x:Name="MessagesList"
                             ItemsSource="{Binding Posts}"
                             Style="{StaticResource FluentListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="8"
                                        Background="{DynamicResource ChipBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" VerticalAlignment="Top">
                                            <Ellipse Fill="{Binding AuthorColor, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                       Text="{Binding AuthorName, Converter={StaticResource InitialsConverter}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Text="{Binding AuthorName}"/>
                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding PostDate, Converter={StaticResource RelativeDateConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,3,0,0"
                                                       Text="{Binding PostContent}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" MinHeight="34"
                                 Text="{Binding NewPostContent, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddPostCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Style="{StaticResource CaptionTextStyle}" Text="Write a message"
                                   Visibility="{Binding NewPostContent, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" MinHeight="34"
                                Margin="8,0,0,0" ToolTip="Send (Enter)"
                                Command="{Binding AddPostCommand}">
                            <TextBlock>
                                <Run Text="S" TextDecorations="Underline"/><Run Text="end"/>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TASKS" Style="{StaticResource CaptionTextStyle}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="28" Padding="10,0"
                                Command="{Binding EditTasksCommand}">
                            <TextBlock>
                                <Run Text="E" TextDecorations="Underline"/><Run Text="dit tasks"/>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}"
                             Style="{StaticResource FluentListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse Fill="Transparent"
                                                 Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1.5"
                                                 Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <Ellipse Fill="{DynamicResource StatusCompletedBrush}"
                                                 Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <Path Width="8" Height="7" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Fill="White" Data="M0,3.6 L2.6,6.2 L8,0.8 L6.6,0 L2.6,3.4 L1.2,2 Z"
                                              Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TaskName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Description}"
                                                   Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MEMBERS" Style="{StaticResource CaptionTextStyle}"
                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Members}"
                             Style="{StaticResource FluentListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                   Text="{Binding ShowName, Converter={StaticResource InitialsConverter}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding ShowName}"/>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding UserEmail}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" Margin="6,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource AccentBrush}"
                                                   Text="Admin"/>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                            ToolTip="Remove from group"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Path Width="9" Height="9" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M0,1.2 L1.2,0 L4.5,3.3 L7.8,0 L9,1.2 L5.7,4.5 L9,7.8 L7.8,9 L4.5,5.7 L1.2,9 L0,7.8 L3.3,4.5 Z"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="4,8,4,2"
                          Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewMemberUserName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Style="{StaticResource CaptionTextStyle}" Text="Invite by username"
                                   Visibility="{Binding NewMemberUserName, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                MinHeight="36" ToolTip="Add member"
                                Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"
                                Foreground="White"
                                Command="{Binding AddMemberCommand}">
                            <TextBlock>
                                <Run Text="A" TextDecorations="Underline"/><Run Text="dd"/>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
