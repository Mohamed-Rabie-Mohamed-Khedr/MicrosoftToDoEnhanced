<Window x:Class="MicrosoftToDoEnhanced.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicrosoftToDoEnhanced"
        mc:Ignorable="d"
        Title="Microsoft To Do Enhanced — Sign in"
        Height="560" Width="920" MinHeight="520" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Placeholder bindings: IsRegisterMode, LoginEmail, LoginPassword, RegisterDisplayName,
         RegisterEmail, RegisterPassword, SelectedAccentColor, LoginCommand, RegisterCommand,
         ToggleModeCommand, IsBusy, ErrorMessage -->
    <Grid>
        <!-- Decorative gradient blobs (Fluent accent) -->
        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-160,-160,0,0" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-140,-140" Opacity="0.2">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Brand pane -->
            <StackPanel VerticalAlignment="Center" Margin="24,0,48,0">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                        Effect="{StaticResource CardShadow}">
                    <Path Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"
                          Data="M2,13 L9,20 L24,4 L21.5,1.6 L9,14.8 L4.5,10.5 Z"/>
                </Border>
                <TextBlock Text="Microsoft To Do" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Enhanced" FontSize="28" FontWeight="Light" Margin="0,-6,0,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" FontSize="13.5"
                           Text="Plan together, finish together. Shared groups, smart views, and tasks that stay in sync with your team."/>
            </StackPanel>

            <!-- Auth card -->
            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Padding="28" Effect="{StaticResource PopupShadow}">
                <Grid>
                    <!-- ============ SIGN IN ============ -->
                    <StackPanel x:Name="LoginSP" d:IsHidden="True" Visibility="Hidden">
                        <TextBlock Text="Welcome back" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
                        <TextBlock Text="Sign in to continue to your tasks" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20"/>

                        <TextBlock Text="Email" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2,2,2,2" FontWeight="Bold"/>

                        <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                 PasswordChanged="OnLoginPasswordChanged" BorderThickness="2,2,2,2" FontWeight="Bold"/>

                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                               Text="{Binding ErrorMessage}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Sign in" Margin="0,18,0,0"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=LoginPasswordBox}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="New here?"/>
                            <Button x:Name="CreateAnAccountB" Style="{StaticResource LinkButtonStyle}" Content="Create an account" Click="CreateAnAccountB_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ REGISTER ============ -->
                    <StackPanel x:Name="CreateAnAccountSP">
                        <TextBlock Text="Create account" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
                        <TextBlock Text="Pick a name, email and your accent color" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20"/>

                        <TextBlock Text="Display name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegisterDisplayName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2,2,2,2" FontWeight="Bold"/>

                        <TextBlock Text="Email" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" FontWeight="Black" BorderThickness="2,2,2,2"/>

                        <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="RegisterPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                 PasswordChanged="OnRegisterPasswordChanged" FontWeight="Black" BorderThickness="2,2,2,2"/>

                        <TextBlock x:Name="YourAccentColorB" Text="Your accent color" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,6" Foreground="#FF0067C0" TextAlignment="Center" Cursor="Hand" MouseUp="YourAccentColorB_MouseUp"/>
                        <ListBox ItemsSource="{Binding AccentColorChoices}" SelectedItem="{Binding SelectedAccentColor}"
                             Style="{StaticResource FluentListBoxStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="26" Height="26" Margin="3"
                                         Fill="{Binding ., Converter={StaticResource HexToBrushConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItemStyle}">
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Create account" Margin="0,18,0,0"
                            Command="{Binding RegisterCommand}"
                            CommandParameter="{Binding ElementName=RegisterPasswordBox}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Already have an account?"/>
                            <Button x:Name="SignInB" Style="{StaticResource LinkButtonStyle}" Content="Sign in"
                                Command="{Binding ToggleModeCommand}" Click="SignInB_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
