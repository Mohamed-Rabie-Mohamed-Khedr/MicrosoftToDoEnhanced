<Window x:Class="MicrosoftToDoEnhanced.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft To Do Enhanced — Sign in"
        Icon="pack://application:,,,/app.ico"
        Height="680" Width="920" MinHeight="640" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="AccentSwatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Width="38" Height="38" CornerRadius="19"
                                Background="Transparent" BorderThickness="3" BorderBrush="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-160,-160,0,0" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-140,-140" Opacity="0.2">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="760">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Margin="24,0,48,0">
                <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                        Effect="{StaticResource CardShadow}">
                    <Path Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}"
                          Data="M2,13 L9,20 L24,4 L21.5,1.6 L9,14.8 L4.5,10.5 Z"/>
                </Border>
                <TextBlock Text="Microsoft To Do" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Enhanced" FontSize="28" FontWeight="Light" Margin="0,-6,0,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" FontSize="13.5"
                           Text="Plan together, finish together. Shared groups, smart views, and tasks that stay in sync with your team."/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Padding="28" Effect="{StaticResource PopupShadow}">
                <Grid>
                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Welcome back" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
                        <TextBlock Text="Sign in to continue to your tasks" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20"/>

                        <TextBlock Text="User name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding LoginUserName, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="2,2,2,2" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding LoginUserNameError}"
                                   Visibility="{Binding LoginUserNameError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                     PasswordChanged="OnLoginPasswordChanged" BorderThickness="2,2,2,2" FontWeight="Bold"/>

                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding LoginError}"
                                   Visibility="{Binding LoginError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource StatusCompletedBrush}" TextWrapping="Wrap"
                                   Text="{Binding LoginInfoMessage}"
                                   Visibility="{Binding LoginInfoMessage, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <CheckBox Style="{StaticResource AccentCheckBoxStyle}" Margin="0,14,0,0"
                                  Content="Remember me"
                                  IsChecked="{Binding IsRememberMe, Mode=TwoWay}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                                IsDefault="True" ToolTip="Sign in (Enter)"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock>
                                <Run Text="S" TextDecorations="Underline"/><Run Text="ign in"/>
                            </TextBlock>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="New here?"/>
                            <Button Style="{StaticResource LinkButtonStyle}" ToolTip="Create a new account"
                                    Command="{Binding ToggleModeCommand}">
                                <TextBlock>
                                    <Run Text="C" TextDecorations="Underline"/><Run Text="reate an account"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Create account" Style="{StaticResource PageTitleTextStyle}" FontSize="22"/>
                        <TextBlock Text="Pick a name, email and your accent color" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20"/>

                        <TextBlock Text="Display name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding RegisterDisplayName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="2,2,2,2" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding RegisterDisplayNameError}"
                                   Visibility="{Binding RegisterDisplayNameError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="User name" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding RegisterUserName, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" BorderThickness="2,2,2,2"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding RegisterUserNameError}"
                                   Visibility="{Binding RegisterUserNameError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="Email (optional)" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}" FontWeight="Black" BorderThickness="2,2,2,2"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding RegisterEmailError}"
                                   Visibility="{Binding RegisterEmailError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="Password" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="RegisterPasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                                     PasswordChanged="OnRegisterPasswordChanged" FontWeight="Black" BorderThickness="2,2,2,2"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Text="{Binding RegisterPasswordError}"
                                   Visibility="{Binding RegisterPasswordError, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="Your accent color" Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,6"/>
                        <ListBox Style="{StaticResource FluentListBoxStyle}"
                                 ItemsSource="{Binding AccentChoices}"
                                 SelectedItem="{Binding SelectedAccentHex}"
                                 ItemContainerStyle="{StaticResource AccentSwatchItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="28" Height="28" Fill="{Binding}" IsHitTestVisible="False"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0"
                                IsDefault="True" ToolTip="Create account (Enter)"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <TextBlock>
                                <Run Text="C" TextDecorations="Underline"/><Run Text="reate account"/>
                            </TextBlock>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Already have an account?"/>
                            <Button Style="{StaticResource LinkButtonStyle}" ToolTip="Back to sign in"
                                    Command="{Binding ToggleModeCommand}">
                                <TextBlock>
                                    <Run Text="S" TextDecorations="Underline"/><Run Text="ign in"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
