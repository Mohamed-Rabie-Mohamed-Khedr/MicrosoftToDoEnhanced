<Window x:Class="MicrosoftToDoEnhanced.Views.ProfileEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit profile"
        Height="560" Width="440" MinHeight="480" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" VerticalAlignment="Center">
                <Ellipse Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="White"
                           Text="{Binding ShowName, Converter={StaticResource InitialsConverter}}"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Edit profile" Style="{StaticResource PageTitleTextStyle}" FontSize="18"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Your name, email and color"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,8">
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="User name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Display name" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding ShowName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Profile color" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,6"/>
                    <ListBox ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding Color}"
                             Style="{StaticResource FluentListBoxStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="24" Height="24" Margin="3"
                                         Fill="{Binding ., Converter={StaticResource HexToBrushConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItemStyle}">
                                <Setter Property="Padding" Value="3"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Margin="0,20,0,4" Padding="16" CornerRadius="{StaticResource CardCornerRadius}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="Danger zone" Style="{StaticResource SectionTitleTextStyle}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,10"
                                       Text="Deleting your account removes your tasks, groups, posts and files permanently."/>
                            <Button Style="{StaticResource DangerButtonStyle}" MinHeight="32" HorizontalAlignment="Left"
                                    Content="Delete account"
                                    Command="{Binding DeleteAccountCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save"
                        Command="{Binding SaveProfileCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
