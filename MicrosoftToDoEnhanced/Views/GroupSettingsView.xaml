<Window x:Class="MicrosoftToDoEnhanced.Views.GroupSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Group settings"
        Height="600" Width="520" MinHeight="480" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Placeholder bindings (DataContext = group settings VM):
         GroupName, GroupDescription, Color, ColorChoices,
         Members (ObservableCollection), NewMemberEmail, AddMemberCommand, RemoveMemberCommand,
         IsOwner, DeleteGroupCommand, SaveGroupCommand, CloseCommand,
         Posts (ObservableCollection), NewPostContent, AddPostCommand, LoadMorePostsCommand, HasMorePosts
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                      Data="M3,0 h10 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-10 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 Z M4,5 h8 v2 h-8 Z M4,8 h8 v2 h-8 Z M4,11 h5 v2 h-5 Z"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Group settings" Style="{StaticResource PageTitleTextStyle}" FontSize="18"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Name, color, members and the activity feed"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnCloseClicked" ToolTip="Close">
                <Path Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M0,1.4 L1.4,0 L5,3.6 L8.6,0 L10,1.4 L6.4,5 L10,8.6 L8.6,10 L5,6.4 L1.4,10 L0,8.6 L3.6,5 Z"/>
            </Button>
        </Grid>

        <!-- ===== Body ===== -->
        <ScrollViewer Grid.Row="1" Padding="20,0,20,8">
            <StackPanel>

                <!-- General -->
                <TextBlock Text="GENERAL" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Description" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" MinHeight="56" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="12,8"
                                 Text="{Binding GroupDescription, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Group color" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,6"/>
                        <ListBox ItemsSource="{Binding ColorChoices}" SelectedItem="{Binding Color}"
                                 Style="{StaticResource FluentListBoxStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="24" Height="24" Margin="3"
                                             Fill="{Binding ., Converter={StaticResource HexToBrushConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItemStyle}">
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Members -->
                <TextBlock Text="MEMBERS" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                                            <Ellipse Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                       Text="{Binding ShowName, Converter={StaticResource InitialsConverter}}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding ShowName}"/>
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding UserEmail}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource BadgeStyle}" Margin="6,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{DynamicResource AccentBrush}"
                                                       Text="Admin"/>
                                        </Border>
                                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                                ToolTip="Remove from group"
                                                Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Width="9" Height="9" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M0,1.2 L1.2,0 L4.5,3.3 L7.8,0 L9,1.2 L5.7,4.5 L9,7.8 L7.8,9 L4.5,5.7 L1.2,9 L0,7.8 L3.3,4.5 Z"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Invite -->
                        <Grid Margin="4,8,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewMemberEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource CaptionTextStyle}" Text="Invite by email"
                                       Visibility="{Binding NewMemberEmail, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                    MinHeight="36" Content="Add"
                                    Command="{Binding AddMemberCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Posts feed -->
                <TextBlock Text="ACTIVITY FEED" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Posts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="8"
                                            Background="{DynamicResource ChipBackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28" VerticalAlignment="Top">
                                                <Ellipse Fill="{Binding AuthorColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="White"
                                                           Text="{Binding AuthorName, Converter={StaticResource InitialsConverter}}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Text="{Binding AuthorName}"/>
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding PostDate, Converter={StaticResource RelativeDateConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,3,0,0"
                                                           Text="{Binding PostContent}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Pagination -->
                        <Button Style="{StaticResource SecondaryButtonStyle}" MinHeight="30"
                                HorizontalAlignment="Stretch" Content="Load 10 more"
                                Visibility="{Binding HasMorePosts, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding LoadMorePostsCommand}"/>

                        <!-- New post -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" MinHeight="34"
                                     Text="{Binding NewPostContent, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddPostCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource CaptionTextStyle}" Text="Share an update with the group"
                                       Visibility="{Binding NewPostContent, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" MinHeight="34"
                                    Margin="8,0,0,0" Content="Post"
                                    Command="{Binding AddPostCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Danger zone -->
                <Border Margin="0,20,0,4" Padding="16" CornerRadius="{StaticResource CardCornerRadius}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Background="Transparent"
                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Danger zone" Style="{StaticResource SectionTitleTextStyle}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,10"
                                   Text="Deleting this group removes its tasks and feed for everyone."/>
                        <Button Style="{StaticResource DangerButtonStyle}" MinHeight="32" HorizontalAlignment="Left"
                                Content="Delete group"
                                Command="{Binding DeleteGroupCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0"
                        Click="OnCloseClicked"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save changes"
                        Command="{Binding SaveGroupCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
