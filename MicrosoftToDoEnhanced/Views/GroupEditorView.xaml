<Window x:Class="MicrosoftToDoEnhanced.Views.GroupEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicrosoftToDoEnhanced.Controls"
        Title="{Binding EditorTitle}"
        Icon="pack://application:,,,/app.ico"
        Height="560" Width="440" MinHeight="480" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                <Path Width="16" Height="16" Stretch="Uniform" Fill="White"
                      Data="M3,0 h10 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-10 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 Z M4,5 h8 v2 h-8 Z M4,8 h8 v2 h-8 Z M4,11 h5 v2 h-5 Z"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource PageTitleTextStyle}" FontSize="18"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Name, description and color"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="20,0,20,8">
            <StackPanel>
                <controls:GroupFieldsEditor/>

                <Border Margin="0,20,0,4" Padding="16" CornerRadius="{StaticResource CardCornerRadius}"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Background="Transparent"
                        Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Danger zone" Style="{StaticResource SectionTitleTextStyle}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,10"
                                   Text="Deleting this group removes its tasks and feed for everyone."/>
                        <Button Style="{StaticResource DangerButtonStyle}" MinHeight="32" HorizontalAlignment="Left"
                                ToolTip="Delete group"
                                Command="{Binding DeleteGroupCommand}">
                            <TextBlock>
                                <Run Text="D" TextDecorations="Underline"/><Run Text="elete group"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                        IsCancel="True" ToolTip="Cancel (Esc)">
                    <TextBlock>
                        <Run Text="C" TextDecorations="Underline"/><Run Text="ancel"/>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding PrimaryActionText}"
                        IsDefault="True" ToolTip="Save (Enter)"
                        Command="{Binding SaveGroupCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
