<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!--
        Default connection string.

        It points at the LocalDB instance that ships with Visual Studio, so the
        repository stays portable and no machine-specific server name is committed.

        Overriding it, in order of precedence:
          1. the MICROSOFTTODOENHANCED_CONNECTIONSTRING environment variable
             (see Core/Data/DbConnectionFactory.cs);
          2. the value below.

        providerName must stay Microsoft.Data.SqlClient: Core references
        Microsoft.Data.SqlClient, not the legacy System.Data.SqlClient.

        After pointing this at a server, run Core/SQL/CreateDatabase.txt once to
        create the schema.
    -->
    <connectionStrings>
        <add name="MicrosoftToDoEnhanced"
             connectionString="Server=(localdb)\MSSQLLocalDB;Database=MicrosoftToDoEnhanced;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
             providerName="Microsoft.Data.SqlClient" />
    </connectionStrings>
</configuration>
