<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Surfaces ============ -->
    <Color x:Key="WindowBackgroundColor">#F3F3F3</Color>
    <Color x:Key="SidebarBackgroundColor">#FAFAFA</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardHoverBackgroundColor">#FCFCFC</Color>
    <Color x:Key="CardBorderColor">#E4E4E4</Color>
    <Color x:Key="DividerColor">#E5E5E5</Color>
    <Color x:Key="HoverBackgroundColor">#11000000</Color>
    <Color x:Key="PressedBackgroundColor">#1F000000</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#D1D1D1</Color>
    <Color x:Key="ChipBackgroundColor">#EFEFEF</Color>
    <Color x:Key="SelectionBackgroundColor">#E2F0FB</Color>

    <!-- ============ Text ============ -->
    <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
    <Color x:Key="TextSecondaryColor">#606060</Color>
    <Color x:Key="TextTertiaryColor">#8A8A8A</Color>

    <!-- ============ Accent ============ -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#1975C5</Color>
    <Color x:Key="AccentPressedColor">#005A9E</Color>
    <Color x:Key="AccentSubtleColor">#E8F2FB</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- ============ Semantic ============ -->
    <Color x:Key="DangerColor">#D13438</Color>
    <Color x:Key="DangerSubtleColor">#FDE7E9</Color>
    <Color x:Key="PriorityHighColor">#D13438</Color>
    <Color x:Key="PriorityMediumColor">#C77D00</Color>
    <Color x:Key="PriorityLowColor">#107C10</Color>
    <Color x:Key="StatusCompletedColor">#107C10</Color>
    <Color x:Key="StatusPendingColor">#CA5010</Color>
    <Color x:Key="StatusNeutralColor">#8A8A8A</Color>
    <Color x:Key="ToastBackgroundColor">#1B1B1B</Color>
    <Color x:Key="ToastTextColor">#FFFFFF</Color>

    <!-- ============ Brushes ============ -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="{StaticResource ChipBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>
    <SolidColorBrush x:Key="PriorityHighBrush" Color="{StaticResource PriorityHighColor}"/>
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="{StaticResource PriorityMediumColor}"/>
    <SolidColorBrush x:Key="PriorityLowBrush" Color="{StaticResource PriorityLowColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{StaticResource StatusNeutralColor}"/>
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="{StaticResource ToastBackgroundColor}"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="{StaticResource ToastTextColor}"/>
</ResourceDictionary>
