<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBackgroundColor">#202020</Color>
    <Color x:Key="SidebarBackgroundColor">#1C1C1C</Color>
    <Color x:Key="CardBackgroundColor">#2C2C2C</Color>
    <Color x:Key="CardHoverBackgroundColor">#323232</Color>
    <Color x:Key="CardBorderColor">#3F3F3F</Color>
    <Color x:Key="DividerColor">#383838</Color>
    <Color x:Key="HoverBackgroundColor">#14FFFFFF</Color>
    <Color x:Key="PressedBackgroundColor">#22FFFFFF</Color>
    <Color x:Key="InputBackgroundColor">#2C2C2C</Color>
    <Color x:Key="InputBorderColor">#484848</Color>
    <Color x:Key="ChipBackgroundColor">#3A3A3A</Color>
    <Color x:Key="SelectionBackgroundColor">#1F3A4D</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#C5C5C5</Color>
    <Color x:Key="TextTertiaryColor">#8F8F8F</Color>

    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentHoverColor">#7ED6FF</Color>
    <Color x:Key="AccentPressedColor">#42B4E8</Color>
    <Color x:Key="AccentSubtleColor">#16324A</Color>
    <Color x:Key="OnAccentColor">#1B1B1B</Color>

    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="DangerSubtleColor">#442726</Color>
    <Color x:Key="PriorityHighColor">#F48771</Color>
    <Color x:Key="PriorityMediumColor">#E5A50A</Color>
    <Color x:Key="PriorityLowColor">#6CCB5F</Color>
    <Color x:Key="StatusCompletedColor">#6CCB5F</Color>
    <Color x:Key="StatusPendingColor">#F9A86B</Color>
    <Color x:Key="StatusNeutralColor">#8F8F8F</Color>
    <Color x:Key="ToastBackgroundColor">#F0F0F0</Color>
    <Color x:Key="ToastTextColor">#1B1B1B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="{StaticResource CardHoverBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="{StaticResource ChipBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>
    <SolidColorBrush x:Key="PriorityHighBrush" Color="{StaticResource PriorityHighColor}"/>
    <SolidColorBrush x:Key="PriorityMediumBrush" Color="{StaticResource PriorityMediumColor}"/>
    <SolidColorBrush x:Key="PriorityLowBrush" Color="{StaticResource PriorityLowColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusPendingBrush" Color="{StaticResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="{StaticResource StatusNeutralColor}"/>
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="{StaticResource ToastBackgroundColor}"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="{StaticResource ToastTextColor}"/>
</ResourceDictionary>
